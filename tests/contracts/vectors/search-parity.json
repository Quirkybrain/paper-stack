    {
      "id": "greek-final-sigma-per-code-point",
      "note": "F-32-1 (wp-32a): both sides fold per code point, so U+03A3 folds to U+03C3 without Final_Sigma context. 'ΟΔΟΣ' folds to 'οδοσ' and no longer matches the final-sigma query 'οδος' (only the already-final 'οδος' word matches); symmetrically, 'οδοσ' matches only the folded 'ΟΔΟΣ'. Asserted identically by the front-end suite and the Rust contract_search_parity suite.",
      "corpus": "ΟΔΟΣ οδος\n",
      "queries": [
        {
          "query": "οδος",
          "caseSensitive": false,
          "expected": [
            {
              "startByte": 9,
              "endByte": 17,
              "lineNumber": 1
            }
          ]
        },
        {
          "query": "οδοσ",
          "caseSensitive": false,
          "expected": [
            {
              "startByte": 0,
              "endByte": 8,
              "lineNumber": 1
            }
          ]
        }
      ]
    },
    {
