{
  "contract": "paperstack-ipc-r1",
  "note": "Shared literal-search parity vectors (ADR-007; contracts §2.1 command 38; NF11). Both the front-end search-core and the Rust search_source service execute these cases; expected offsets are computed from the normative rule, never from implementation output.",
  "foldingRule": "caseSensitive=false folds both sides per Unicode code point with Unicode default lowercase conversion (front-end `foldLower` helper in src/features/search/search-core.ts / Rust char::to_lowercase). The front-end must NOT use whole-string String.prototype.toLowerCase: it applies the context-sensitive Final_Sigma rule (Σ at a word end -> ς) and diverged from Rust (F-32-1, fixed in wp-32a). No normalization, no regex, no tokenizing. Matches are leftmost non-overlapping, in document order. Offsets address the original text as UTF-8 bytes; lineNumber is 1-based and counts LF. The only remaining per-side divergence is the accepted length-changing İ fold, pinned in boundaryCases.",
  "cases": [
    {
      "id": "ascii-case-and-lines",
      "note": "ASCII fold, every occurrence, 1-based LF lines, no trailing newline.",
      "corpus": "Alpha beta ALPHA\nbeta Alpha\n",
      "queries": [
        {
          "query": "alpha",
          "caseSensitive": false,
          "expected": [
            {
              "startByte": 0,
              "endByte": 5,
              "lineNumber": 1
            },
            {
              "startByte": 11,
              "endByte": 16,
              "lineNumber": 1
            },
            {
              "startByte": 22,
              "endByte": 27,
              "lineNumber": 2
            }
          ]
        },
        {
          "query": "Alpha",
          "caseSensitive": true,
          "expected": [
            {
              "startByte": 0,
              "endByte": 5,
              "lineNumber": 1
            },
            {
              "startByte": 22,
              "endByte": 27,
              "lineNumber": 2
            }
          ]
        },
        {
          "query": "ALPHA",
          "caseSensitive": true,
          "expected": [
            {
              "startByte": 11,
              "endByte": 16,
              "lineNumber": 1
            }
          ]
        },
        {
          "query": "missing",
          "caseSensitive": false,
          "expected": []
        }
      ]
    },
    {
      "id": "literal-not-regex",
      "note": "Metacharacters are literal; a regex engine would match more.",
      "corpus": "a.b a-b a*b a.b\n",
      "queries": [
        {
          "query": "a.b",
          "caseSensitive": true,
          "expected": [
            {
              "startByte": 0,
              "endByte": 3,
              "lineNumber": 1
            },
            {
              "startByte": 12,
              "endByte": 15,
              "lineNumber": 1
            }
          ]
        },
        {
          "query": "a*b",
          "caseSensitive": true,
          "expected": [
            {
              "startByte": 8,
              "endByte": 11,
              "lineNumber": 1
            }
          ]
        },
        {
          "query": "a?b",
          "caseSensitive": true,
          "expected": []
        }
      ]
    },
    {
