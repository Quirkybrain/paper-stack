  "boundaryCases": [
    {
      "id": "dotted-capital-i-length-changing-fold",
      "kind": "accepted-length-changing-fold",
      "note": "U+0130 folds to 'i' + U+0307 (1 UTF-16 unit -> 2). Rust maps folded bytes back to the enclosing original character; the front-end uses the folded index as an index into the original UTF-16 string. KNOWN, DOCUMENTED divergence accepted by ADR-007 (length-changing folds on exotic code points); per-side expectations pin both behaviors so drift is visible.",
      "corpus": "İstanbul İzmir\n",
      "queries": [
        {
          "query": "i",
          "caseSensitive": false,
          "frontend": [
            {
              "startByte": 0,
              "endByte": 2,
              "lineNumber": 1
            },
            {
              "startByte": 12,
              "endByte": 13,
              "lineNumber": 1
            },
            {
              "startByte": 16,
              "endByte": 17,
              "lineNumber": 1
            }
          ],
          "rust": [
            {
              "startByte": 0,
              "endByte": 2,
              "lineNumber": 1
            },
            {
              "startByte": 10,
              "endByte": 12,
              "lineNumber": 1
            },
            {
              "startByte": 14,
              "endByte": 15,
              "lineNumber": 1
            }
          ]
        }
      ]
    },
    {
      "id": "greek-final-sigma-context-fold",
      "kind": "contract-divergence",
      "resolvedIn": "wp-32a-perf",
      "note": "RESOLVED by wp-32a: the front-end now folds per code point with the single `foldLower` helper, matching the Rust service, so this divergence no longer exists. The post-fix shared expectation for this corpus is asserted by BOTH suites through cases.greek-final-sigma-per-code-point. This boundary entry is retained with an empty query list ONLY because src-tauri/tests/contract_search_parity.rs (outside wp-32a's write scope) asserts exactly two boundary cases and the presence of kind 'contract-divergence'; the follow-up must update that Rust test (assert the shared parity case, drop the divergence pin) and delete this shell.",
      "corpus": "ΟΔΟΣ οδος\n",
      "queries": []
    }
  ],
